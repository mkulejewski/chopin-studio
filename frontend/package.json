{
  "name": "chopin-studio-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "format:check": "prettier --check 'src/{main,App,Learning,PracticeReview,AnalysisEvidence,PassageComparison,CompareTakes,PracticeProgress,ProgressHistory,Score,LearningStaves,ScoreComparison}.tsx' 'src/{analysisUtils,appTypes,comparisonJudgement,comparisonPdf,comparisonScore}.ts' 'src/{analysis,components,dialogs,hooks,learning,pages,practice,score,styles,types}/**/*.{ts,tsx,css}' 'playwright*.ts' 'e2e/{following.spec,music-fixture,practice.spec,refactoring-profile.spec}.ts'"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "opensheetmusicdisplay": "^2.2.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "svg2pdf.js": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.0"
  }
}
