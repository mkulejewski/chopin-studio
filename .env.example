# Set only when overriding XDG application data. Never commit personal data.
# CHOPIN_DATA_DIR=/home/you/.local/share/chopin-studio
# CHOPIN_NO_HARDWARE=1
# No network calls occur during ordinary recording. Explicit optional AI reporting can use OPENAI_API_KEY.
# Optional render worker address-space ceiling in MiB (Linux; default 2048).
# CHOPIN_RENDER_MEMORY_MB=2048
# Optional cloud reporting: OPENAI_API_KEY or protected local key configured by touch.
